branch 1 : -2*sqrt(A0)*sqrt(T)*asinh(sqrt(T)/sqrt(A0)) + 2*sqrt(A0)*sqrt(A0 + T) + 2*A0 + C1*sqrt(T)
branch -1 : 2*sqrt(A0)*sqrt(T)*asinh(sqrt(T)/sqrt(A0)) - 2*sqrt(A0)*sqrt(A0 + T) + 2*A0 + C1*sqrt(T)
